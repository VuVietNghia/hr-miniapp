# Runtime mode is auto-detected by @privos_ai/app-server:
#   managed: PRIVOS_WORKLOAD_SOCKET exists
#   standalone-production: PRIVOS_STANDALONE_IDENTITY_FILE exists
#   development: neither exists and NODE_ENV is not production
# Both production identity sources at once are fatal. With NODE_ENV=production
# and neither source, the process serves only degraded manifest/liveness routes,
# readiness stays 503, and MCP dispatch fails closed. Never force production
# into development mode.

# Development Relay cache only. The development pairing prompt may populate a
# local ignored .env; these credentials are never consulted as managed or
# standalone production authority.
# PRIVOS_TRANSPORT=relay
# PRIVOS_URL=
# CLIENT_ID=
# CLIENT_SECRET=
# MCP_APP_ID=

# Development Vite iframe transport (optional).
# PRIVOS_DEV_UI=1
# DEV_TUNNEL=localhost
# VITE_PORT=5179
# PUBLIC_URL=

# Standalone production. Run `npm run pair` twice: register, obtain Hub-owner
# approval, then rerun to resume and atomically persist the owner-only identity.
# NODE_ENV=production
# PRIVOS_STANDALONE_IDENTITY_FILE=
# PORT=3000

# Managed production. The platform mounts the workload socket and supplies its
# installation/workspace values; do not add development OAuth credentials.
# NODE_ENV=production
# PRIVOS_WORKLOAD_SOCKET=
# PRIVOS_APP_ID=
# PRIVOS_INSTALLATION_ID=
# PRIVOS_WORKSPACE_ID=
# PORT=3000

# EmailJS delivery configuration. Supply values through the local secret store
# or production secret manager; never commit values.
# EMAILJS_SERVICE_ID=
# EMAILJS_TEMPLATE_ID=
# EMAILJS_PUBLIC_KEY=
# EMAILJS_PRIVATE_KEY=

# Platform-injected installation bot values. Operators do not copy them from
# logs and do not place them in development configuration.
# PRIVOS_AGENT_BOT_CREDENTIAL=
# PRIVOS_AGENT_BOT_USER_ID=
